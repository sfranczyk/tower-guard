    "peerjs": "^1.5.5",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "html-webpack-plugin": "^5.6.8",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "private": true
